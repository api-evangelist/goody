{
  "opencollection": "1.0.0",
  "info": {
    "name": "Goody Brands Orders API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cancel an order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ongoody.com/v1/orders/:id/cancel",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "id"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Cancel an order"
        },
        {
          "info": {
            "name": "List orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ongoody.com/v1/orders",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page for pagination, starting at 1"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Items per page for pagination"
              },
              {
                "name": "created_at[after]",
                "value": "",
                "type": "query",
                "description": "Filter orders created at or after this timestamp (ISO 8601, UTC unless otherwise specified in timestamp)"
              },
              {
                "name": "created_at[before]",
                "value": "",
                "type": "query",
                "description": "Filter orders created at or before this timestamp (ISO 8601, UTC unless otherwise specified in timestamp)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List orders"
        },
        {
          "info": {
            "name": "Retrieve an order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ongoody.com/v1/orders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "id"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve an order"
        },
        {
          "info": {
            "name": "Update expiration for an order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ongoody.com/v1/orders/:id/update_expiration",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update expiration for an order"
        }
      ]
    }
  ],
  "bundled": true
}